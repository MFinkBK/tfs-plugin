<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>tfs-parent</artifactId>
    <version>5.157.2-SNAPSHOT</version>
  </parent>

  <artifactId>tfs-sdk-original</artifactId>
  <name>TFS SDK installer</name>
  <description>
    Installs the original Microsoft TFS SDK jar into the local Maven repository,
    so the tfs-sdk module can repackage it. This module must come before tfs-sdk
    in the parent's module list.
  </description>
  <packaging>pom</packaging>

  <properties>
    <tfs-sdk.version>14.0.3</tfs-sdk.version>
  </properties>

  <!-- http://stackoverflow.com/a/31511080/98903 -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.1.3</version>
        <executions>
          <execution>
            <id>install.tfs.sdk.jar.locally</id>
            <phase>validate</phase>
            <goals>
              <goal>install-file</goal>
            </goals>
            <configuration>
              <file>src/com.microsoft.tfs.sdk-${tfs-sdk.version}.jar</file>
              <groupId>com.microsoft.tfs.sdk</groupId>
              <artifactId>com.microsoft.tfs.sdk-original</artifactId>
              <version>${tfs-sdk.version}</version>
              <packaging>jar</packaging>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
